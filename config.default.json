{
  "$comment": "DSH host RSI 配置默认值（bundle 行配置可覆盖）。dir 为人可读的记忆目录（权威源 + 倒排索引），省略时默认 ~/.dsh/rsi-memory（DSH_HOME 环境变量可覆盖），不再写死盘符。enabled=false 时插件完全空操作；flushMs 为后台写入的防抖间隔（ms）。",
  "enabled": true,
  "dir": null,
  "flushMs": 1000,
  "inject": {
    "topK": 3,
    "tokenBudget": 1000,
    "candCap": 40,
    "enabled": true,
    "includeQuarantined": false,
    "oncePerTask": false,
    "selfCheck": true,
    "maxInjectsPerTask": 2,
    "reinjectOn": [
      "tool-failure",
      "repeated-failure"
    ],
    "compactTopK": 1,
    "compactTokenBudget": 300
  },
  "capture": {
    "enabled": true,
    "maxPerSession": 10,
    "minChars": 120,
    "dedupeThreshold": 0.8,
    "captureUserCorrections": true,
    "captureUserInstructions": true
  },
  "importRecent": {
    "enabled": true,
    "limit": 30,
    "sessions": 10
  },
  "escalate": {
    "enabled": true,
    "maxCriticsPerSession": 3,
    "selfConsistency": 1,
    "threshold": 0.6
  },
  "dashboard": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 0,
    "recent": 15,
    "webserver": true
  },
  "convergence": {
    "enabled": true,
    "repeatThreshold": 3,
    "models": [
      "*27b*"
    ]
  },
  "guard": {
    "enabled": true,
    "maxRetries": 2,
    "maxPerSession": 4,
    "thresholdEmpty": 400,
    "thresholdFile": 2000,
    "sameToolStreak": 3,
    "fileTurnRe": "file|write|create|generate|implement|fix|script|\\.(?:js|ts|py|json|md|yml|yaml)|文件|创建|编写|生成|修复|脚本",
    "tasksRe": "write|create|fix|implement|optimize|design|analyze|generate|refactor|debug|test|build|migrate|check|translate|convert|编写|写|创建|修复|实现|优化|设计|分析|生成|重构|调试|测试|构建|迁移|检查|翻译|转换",
    "recordTrajectory": true
  },
  "embeddings": null
}
